{
  "name": "Facility",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Facility name"
    },
    "description": {
      "type": "string",
      "description": "Facility description"
    },
    "icon": {
      "type": "string",
      "description": "Symbol key",
      "enum": [
        "floor",
        "projector",
        "basketball",
        "book",
        "dumbbell",
        "curtain"
      ],
      "default": "book"
    },
    "lat": {
      "type": "number",
      "description": "Pin latitude"
    },
    "lng": {
      "type": "number",
      "description": "Pin longitude"
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photo URLs"
    },
    "rental_cost": {
      "type": "string",
      "description": "Rental cost"
    },
    "rental_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rental requirements"
    },
    "policies": {
      "type": "array",
      "description": "Policy sections displayed on the facility page",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "description": "Section heading"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Policy lines"
          }
        },
        "required": [
          "heading",
          "items"
        ]
      }
    },
    "sort_order": {
      "type": "number",
      "description": "Display order",
      "default": 0
    }
  },
  "required": [
    "name",
    "icon",
    "lat",
    "lng"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}